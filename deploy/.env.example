# Copy to .env and edit. Do not commit .env.

# Public hostname Caddy serves on (the A record points here).
# Example: mcp.derod.org
DOMAIN=mcp.derod.org

# Email for Let's Encrypt failure notifications.
ACME_EMAIL=admin@example.com

# Version of dero-mcp-server to install in the container. Pin to a
# specific release; track CHANGELOG.md for upgrades.
DERO_MCP_VERSION=0.6.0

# JSON-RPC base of the DERO daemon the MCP queries. Three common shapes:
#
#   1. Daemon running on the SAME VPS, outside Docker (recommended):
#      DERO_DAEMON_URL=http://host.docker.internal:10102
#
#   2. Daemon running in another container or on another host:
#      DERO_DAEMON_URL=http://10.0.0.5:10102
#
#   3. Skip the daemon entirely (only the docs tools work):
#      DERO_DAEMON_URL=  (leave empty; falls back to the package default)
#
DERO_DAEMON_URL=http://host.docker.internal:10102

# Bearer token required on every /mcp request. Generate with:
#   openssl rand -base64 48
# Leave EMPTY if you intentionally want public unauthenticated access
# (e.g. a docs-only demo). Highly recommended to set this if the daemon
# is reachable (any client could otherwise exhaust the daemon's RPC).
DERO_MCP_AUTH_TOKEN=
